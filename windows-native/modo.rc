#define VS_VERSION_INFO 1
#define VOS_NT_WINDOWS32 0x00040004L
#define VFT_APP 0x00000001L
#define VFT2_UNKNOWN 0x00000000L

101 ICON "../legacy-windows/assets/app_icon.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,3,0,0
PRODUCTVERSION  1,3,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Atoma\0"
            VALUE "FileDescription",  "Modo - Adaptive Icon Studio by Atoma\0"
            VALUE "FileVersion",      "1.3.0.0\0"
            VALUE "InternalName",     "Modo.exe\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Atoma. All rights reserved.\0"
            VALUE "OriginalFilename", "Modo.exe\0"
            VALUE "ProductName",      "Modo for Windows\0"
            VALUE "ProductVersion",   "1.3.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
