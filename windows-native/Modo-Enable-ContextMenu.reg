Windows Registry Editor Version 5.00

; ====================================================================
; Modo — Windows Explorer Right-Click Context Menu Integration
; Opens the selected .exe, .lnk, or folder directly in Modo Studio
; Requires no administrative rights (writes to HKEY_CURRENT_USER)
; ====================================================================

; 1. Executable files (.exe)
[HKEY_CURRENT_USER\Software\Classes\exefile\shell\ModoStyle]
@="Стилизовать иконку в Modo..."
"Icon"="\"%LOCALAPPDATA%\\Programs\\Modo\\Modo.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\exefile\shell\ModoStyle\command]
@="cmd.exe /c start \"\" \"%LOCALAPPDATA%\\Programs\\Modo\\Modo.exe\" --open-target \"%1\""

; 2. Windows Shortcuts (.lnk)
[HKEY_CURRENT_USER\Software\Classes\lnkfile\shell\ModoStyle]
@="Стилизовать иконку в Modo..."
"Icon"="\"%LOCALAPPDATA%\\Programs\\Modo\\Modo.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\lnkfile\shell\ModoStyle\command]
@="cmd.exe /c start \"\" \"%LOCALAPPDATA%\\Programs\\Modo\\Modo.exe\" --open-target \"%1\""

; 3. File Explorer Folders (Directory)
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\ModoFolder]
@="Изменить цвет папки в Modo..."
"Icon"="\"%LOCALAPPDATA%\\Programs\\Modo\\Modo.exe\",0"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\ModoFolder\command]
@="cmd.exe /c start \"\" \"%LOCALAPPDATA%\\Programs\\Modo\\Modo.exe\" --open-target \"%1\""
